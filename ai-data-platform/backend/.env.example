# MySQL 只读从库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=analytics_readonly
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# SQLite 本地数据库（存储对话、配置等）
SQLITE_PATH=./data/platform.db

# LLM API 配置 (DeepSeek)
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# 备用: 小米MiMo
# LLM_PROVIDER=mimo
# LLM_API_KEY=your_mimo_api_key
# LLM_MODEL=mimo-chat
# LLM_BASE_URL=https://api.mimo.ai/v1

# 应用配置
APP_NAME=AI数据分析中台
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-this

# 查询安全限制
MAX_QUERY_TIMEOUT=30
MAX_QUERY_ROWS=10000
MAX_QUERY_PER_MINUTE=60

# 邮件告警配置 (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
ALERT_FROM_EMAIL=alert@example.com
ALERT_TO_EMAIL=your_email@example.com
